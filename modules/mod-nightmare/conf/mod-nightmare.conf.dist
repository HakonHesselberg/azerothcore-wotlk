# Nightmare Northshire. Installed under configs/modules/ by AzerothCore.
# Copy to mod-nightmare.conf to customize; restart worldserver after changes.
# Invalid out-of-range values are clamped to the documented range.

# Fire radius in yards (1.0-40.0) and vertical tolerance (0.5-10.0).
Nightmare.FireRadius = 8.0
Nightmare.FireHeightTolerance = 3.0

# Lifetime in seconds (1-3600) and player damage interval in ms (100-60000).
Nightmare.FireDurationSeconds = 600
Nightmare.FireTickMs = 2000

# Fraction of maximum HP per tick (0.01-1.0; 0.10 means 10%).
Nightmare.FireDamagePercent = 0.10

# Kobold Candle Frenzy damage factor (1.0-10.0).
Nightmare.FrenzyDamageMultiplier = 2.0

# Attack period factor (0.1-1.0; 0.5 means twice as many swings).
Nightmare.FrenzyAttackTimeMultiplier = 0.5

# Run speed factor (1.0-3.0; 1.5 means +50% speed).
Nightmare.FrenzyMoveSpeedMultiplier = 1.5

# Maximum fires within twice the fire radius (1-50).
Nightmare.MaxNearbyFires = 5

# Flee at or below this percentage of max health unless Candle Frenzy is active (1-100).
# Shared by Northshire Vermin, Workers and Laborers. Fleeing does not seek assistance.
Nightmare.FleeHealthPercent = 20.0

# Diseased wolves: Infected Bite lasts 10 seconds and stacks up to 10 times.
# Each successful wolf melee hit refreshes the duration and adds one stack.
Nightmare.WolfMaxStacks = 10
Nightmare.WolfInfectionDurationMs = 10000

# Each stack increases damage taken from every source and slows movement by 10%.
# At 10 stacks with the defaults, movement is completely stopped.
Nightmare.WolfDamageBonusPerStack = 0.10
Nightmare.WolfSlowPerStack = 0.10

# Wolves howl once per combat at or below 50% health. After the warning,
# every eligible unengaged wolf within 30 yards joins the fight.
# Recruited wolves may howl themselves when wounded.
Nightmare.WolfHowlHealthPercent = 50.0
Nightmare.WolfHowlWarningMs = 2000
Nightmare.WolfHowlRadius = 30.0
